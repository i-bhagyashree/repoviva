# Copy this file to .env (in this server folder) and fill in the values.

# OPTIONAL. Claude API key from https://console.anthropic.com for a deeper AI review.
# Leave it empty and the app still works fully: the built-in review engine
# (rule checks + stack-based interview questions + key-point answer grading) is used.
ANTHROPIC_API_KEY=

# Optional: which Claude model to use. Default is claude-opus-5-5 (best quality).
# Cheaper options: claude-sonnet-5-5, claude-haiku-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: GitHub token to raise the rate limit from 60 to 5000 requests/hour.
# GITHUB_TOKEN=

# Port for the API server.
# PORT=4000

# Optional: secret used to sign login tokens. If empty, one is generated
# automatically and kept in server/data/secret.key.
# AUTH_SECRET=

# Optional: where accounts and reports are stored (default: server/data).
# DATA_DIR=
